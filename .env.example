# Copy this file to .env and fill in your values.
# Never commit your real .env file — it contains secrets.

# ── Admin Panel ───────────────────────────────────────────────
# Password to log into /admin — choose something strong.
ADMIN_PASSWORD=change-me-to-a-strong-password

# ── Stripe Payments ───────────────────────────────────────────
# Get your keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... while testing, sk_live_... when you go live.
STRIPE_SECRET_KEY=sk_test_...

# ── Server ────────────────────────────────────────────────────
# Port the server listens on (default: 3000)
# PORT=3000

# ── Self-Hosting ──────────────────────────────────────────────
# If your store is accessible at a public URL (domain or IP),
# set BASE_URL so Stripe can redirect customers back correctly.
# Example: BASE_URL=http://192.168.1.100:3000
# Example: BASE_URL=https://mystore.com
# BASE_URL=http://localhost:3000
